{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "players-route": {
        "ClusterId": "players-cluster",
        "Match": {
          "Path": "/api/players/{**catch-all}"
        }
      },
      "games-route": {
        "ClusterId": "games-cluster",
        "Match": {
          "Path": "/api/games/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "players-cluster": {
        "Destinations": {
          "players-destination": {
            "Address": "http://cardcheesi-players-api"
          }
        }
      },
      "games-cluster": {
        "Destinations": {
          "games-destination": {
            "Address": "http://cardcheesi-game-api"
          }
        }
      }
    }
  }
}
